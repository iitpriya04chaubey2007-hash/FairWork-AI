{
  "name": "fairwork-ai",
  "version": "1.0.0",
  "description": "FairWork AI - Manual Workforce Management for Fair, Safe, and Transparent Labor",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
