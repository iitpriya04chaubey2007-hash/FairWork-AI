# FairWork AI - Environment Configuration Example

# Port for backend service (Google Cloud Run automatically sets PORT to 8080)
PORT=8080
NODE_ENV=development

# --- Firebase Firestore Configuration (Optional) ---
# If left blank or unconfigured, the app runs in full-fidelity In-Memory Demo Mode
# with 16+ preloaded workers, shifts, wages, and safety records.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or path to service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
