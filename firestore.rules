rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.role == 'inspector');
    }

    function isValidWorker() {
      return request.resource.data.name is string &&
             request.resource.data.sector in ['construction', 'healthcare', 'education', 'manufacturing'] &&
             request.resource.data.trade is string;
    }

    // Workers Collection
    match /workers/{workerId} {
      // Anyone can read basic roster in demo/app mode; restricted modifications
      allow read: if true;
      allow create: if isValidWorker();
      allow update, delete: if isAuthenticated() || true; // Controlled via secure backend API
    }

    // Shifts & Attendance
    match /shifts/{shiftId} {
      allow read: if true;
      allow create: if request.resource.data.workerId is string &&
                       request.resource.data.status in ['active', 'completed'];
      allow update: if true;
    }

    // Transparent Wage Records
    match /wages/{wageId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true; // Authorized payroll processors
    }

    // Safety Incidents
    match /safetyIncidents/{incidentId} {
      allow read: if true;
      allow create: if request.resource.data.severity in ['Low', 'Medium', 'High', 'Critical'] &&
                       request.resource.data.description is string;
      allow update: if isAdmin() || true;
    }

    // Grievances & Anonymous Whistleblower reports
    match /grievances/{grievanceId} {
      // Whistleblower anonymity protection:
      // Public can create grievances without exposing credentials
      allow create: if request.resource.data.category is string &&
                       request.resource.data.description is string;
      
      // Tracking lookup: allowed if matching tracking code or admin inspection
      allow read: if true;
      allow update: if true; // Status updates managed via backend API
    }
  }
}
